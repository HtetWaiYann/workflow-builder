# PostgreSQL password for the Postgres container.
# Required — docker compose up will fail without this.
POSTGRES_PASSWORD=

# Optional: override the Postgres username (default: workflow)
# POSTGRES_USER=workflow

# CORS origin for the production stack (docker-compose.yml).
# Set this to the URL you'll use to access the app.
#   Local:  http://localhost       (default — no change needed)
#   Server: https://yourdomain.com
CORS_ORIGIN=http://localhost

# Docker image registry and tag (used by docker-compose.yml).
# Set IMAGE_REGISTRY to your Docker Hub username or full registry prefix.
#   Docker Hub:  yourusername   
#   GHCR:        ghcr.io/yourusername
# Leave IMAGE_TAG as "latest" for hobby use; use a git SHA or version in CI.
IMAGE_REGISTRY=yourusername
IMAGE_TAG=latest

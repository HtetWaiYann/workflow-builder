{
  "name": "triggr",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=packages/shared",
    "dev:backend": "npm run dev --workspace=packages/backend",
    "dev:frontend": "npm run dev --workspace=packages/frontend",
    "build": "npm run build --workspaces --if-present",
    "docs": "typedoc",
    "format": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,js,jsx,json,css}\"",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspace=packages/frontend && npm run test:coverage --workspace=packages/backend",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=packages/backend",
    "db:migrate": "npm run db:migrate --workspace=packages/backend",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=packages/backend",
    "db:studio": "npm run db:studio --workspace=packages/backend"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.7.0",
    "typedoc": "^0.28.19",
    "typescript": "^5.8.3"
  }
}

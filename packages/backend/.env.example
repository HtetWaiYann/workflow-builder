PORT=3001
DATABASE_URL="postgresql://user:password@localhost:5432/workflow_builder?schema=public"
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"

# AES-256-GCM master key for encrypting workspace variables (required).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="64-character-hex-string-here"

# Redis connection for cron trigger scheduling (optional).
# If unset, cron triggers are disabled; manual and webhook triggers still work.
REDIS_URL="redis://localhost:6379"

# Maximum duration a delay node is allowed to wait (optional, default 300000ms = 5 min).
MAX_DELAY_MS=300000

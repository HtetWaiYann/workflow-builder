PORT=3001
DATABASE_URL="postgresql://user:password@localhost:5432/workflow_builder?schema=public"
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"

# AES-256-GCM master key for encrypting workspace variables (required).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="64-character-hex-string-here"

# Redis connection for cron trigger scheduling (optional).
# If unset, cron triggers are disabled; manual and webhook triggers still work.
REDIS_URL="redis://localhost:6379"

# Maximum duration a delay node is allowed to wait (optional, default 300000ms = 5 min).
MAX_DELAY_MS=300000

# ── Docker ────────────────────────────────────────────────────────────────────
# When running via docker-compose, the DATABASE_URL and REDIS_URL below are
# overridden by the compose file using Docker service names. These values are
# only used if you connect to the dockerised Postgres/Redis from your local machine.
#
# docker-compose.yml (production) overrides:
#   DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/workflow_builder?schema=public
#   REDIS_URL=redis://redis:6379
#   CORS_ORIGIN=http://localhost
#
# docker-compose.dev.yml (development) overrides:
#   DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/workflow_builder?schema=public
#   REDIS_URL=redis://redis:6379
#   CORS_ORIGIN=http://localhost:5173
#
# Required shell environment variables for both compose files:
#   POSTGRES_USER=workflow        (optional, defaults to "workflow")
#   POSTGRES_PASSWORD=<secret>    (required — set in your shell or a root .env)
